FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AEGIS_ENABLED=1

WORKDIR /app

COPY pyproject.toml requirements-py.lock* ./
COPY aegis ./aegis
COPY config ./config
COPY scripts ./scripts
COPY benchmarks ./benchmarks

RUN pip install --no-cache-dir -e .

USER 65534:65534

EXPOSE 8080

CMD ["python", "-B", "-m", "aegis.cli", "--help"]
