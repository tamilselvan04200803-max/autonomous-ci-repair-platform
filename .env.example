# ---- required ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- control plane ----------------------------------------------------------
# Public HTTPS address; used in check runs, PR bodies and attestations.
FORGE_PUBLIC_URL=http://localhost:3000
# Locks admin endpoints (POST /api/runs, /propose, /upstream). Unset = open local mode.
FORGE_ADMIN_TOKEN=
# Shared with the runner (AEGIS_RUNNER_SECRET or FORGE_RUNNER_SECRET).
FORGE_RUNNER_SECRET=
AEGIS_RUNNER_SECRET=
# Patches at or above this risk are never published.
FORGE_RISK_CEILING=0.35
# Comma-separated owner/repo allow-list for webhooks (empty = all).
FORGE_REPO_ALLOWLIST=
# Ed25519 PKCS#8 PEM. If unset, a key is generated once and stored in Postgres.
# openssl genpkey -algorithm ed25519
FORGE_SIGNING_KEY=

# ---- GitHub (either a token or an App) --------------------------------------
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_API_URL=https://github.example.com/api/v3   # GitHub Enterprise Server

# ---- patch model (any OpenAI-compatible endpoint) ---------------------------
# OpenAI: https://api.openai.com/v1 (model: gpt-4o-mini)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ (model: gemini-2.0-flash)
# Ollama: http://localhost:11434/v1 (model: llama3)
FORGE_LLM_API_KEY=
FORGE_LLM_BASE_URL=https://api.openai.com/v1
FORGE_LLM_MODEL=gpt-4o-mini
FORGE_CANDIDATES=3
FORGE_LLM_USD_PER_1K=0.002
